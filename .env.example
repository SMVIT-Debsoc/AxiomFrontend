# Clerk Authentication (Free Tier from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend API endpoint (defaults to http://localhost:3000/api in development)
VITE_API_URL=http://localhost:3000/api

# Optional Socket.IO endpoint
VITE_SOCKET_URL=http://localhost:3000

# Admin Console Secret Key (should match backend ADMIN_SECRET_KEY)
VITE_ADMIN_SECRET_KEY=
