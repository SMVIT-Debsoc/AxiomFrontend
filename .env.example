# Temporary Auth.js sign-in (used automatically when VITE_CLERK_PUBLISHABLE_KEY is empty)
AUTH_SECRET=              # openssl rand -base64 32
TEMP_ADMIN_PASSCODE=      # passcode that signs in as admin
TEMP_PARTICIPANT_PASSCODE= # passcode that signs in as participant

# Clerk (takes over automatically once a key is set)
VITE_CLERK_PUBLISHABLE_KEY=
# Force a provider: "temporary" or "clerk" (optional)
VITE_AUTH_PROVIDER=
